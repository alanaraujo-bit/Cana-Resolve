# Copie para .env.local e preencha.

# Postgres. Em produção é o proxy TCP público da Railway (projeto
# canaa-resolve, serviço Postgres). Sem esta variável o Operations não sobe e
# as rotas públicas param de gravar — mas continuam abrindo o WhatsApp.
DATABASE_URL="postgresql://usuario:senha@host:porta/banco"

# Domínio público. Só é necessário fora de produção, quando o canônico muda.
# NEXT_PUBLIC_SITE_URL="https://canaaresolve.aionixdev.com"

# Usadas apenas por `npm run inspect` e `npm run smoke`, para entrar no
# Operations durante a verificação automatizada.
OPS_EMAIL="voce@exemplo.com"
OPS_SENHA="a-senha-do-operador"

# Tamanho do pool de conexões. O padrão (10) serve; baixe se o plano do
# Postgres tiver um teto menor.
# CR_DB_POOL_MAX=10
