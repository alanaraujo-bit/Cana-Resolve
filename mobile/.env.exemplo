# Canaã Resolve — aplicativo
#
# Copie para `.env` e preencha. Nada aqui é segredo: são identificadores
# públicos de cliente OAuth e a base da API. O `client secret` do Google vive
# no servidor que troca o código por sessão — nunca no aplicativo.
#
# Enquanto estiver tudo vazio, o aplicativo abre normalmente: onboarding e
# login funcionam, e os caminhos de autenticação se declaram indisponíveis.

# Base da API de autenticação. Ex.: https://api.canaaresolve.com.br/v1
EXPO_PUBLIC_AUTH_API_URL=

# Client IDs do Google (Google Cloud Console → Credenciais → OAuth 2.0)
EXPO_PUBLIC_GOOGLE_CLIENT_ID_IOS=
EXPO_PUBLIC_GOOGLE_CLIENT_ID_ANDROID=
EXPO_PUBLIC_GOOGLE_CLIENT_ID_WEB=

# Base da API que serve dados (oportunidades, perfil). Separada da de
# autenticação porque as duas não ficam prontas no mesmo dia.
EXPO_PUBLIC_DATA_API_URL=
