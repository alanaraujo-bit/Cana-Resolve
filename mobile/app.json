{
  "expo": {
    "name": "Canaã Resolve",
    "slug": "canaa-resolve",
    "scheme": "canaaresolve",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "primaryColor": "#0E5C42",
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "bundleIdentifier": "com.aionix.canaaresolve",
      "supportsTablet": false,
      "usesAppleSignIn": true,
      "infoPlist": {
        "CFBundleDisplayName": "Canaã Resolve",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.aionix.canaaresolve",
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0E5C42"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-web-browser",
      "expo-apple-authentication",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 148,
          "resizeMode": "contain",
          "backgroundColor": "#FBF9F5",
          "dark": {
            "image": "./assets/splash-icon-dark.png",
            "backgroundColor": "#0C1310"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
